---
const { instructions, rules, recommendations, moving, lang } = Astro.props;
---

<!--Header--><!--Div delimitador header -->
<div
  class="flex justify-between font-bold items-end hover:bg-slate-200 transition-all duration-300 ease-in-out py-4 touch:bg-mist-200/50"
>
  <!-- Div logo -->
  <div class="hidden sm:inline ml-8">
    <p class="hidden sm:inline w-28">SAN ISIDORO <br />12 APTO. 14</p>
  </div>
  <!-- Div menu central -->
  <div class="hidden lg:inline">
    <ul class="flex space-between text-base">
      <li
        class="py-1 px-3 rounded-full hover:bg-slate-300 transition-all duration-300 ease-in-out cursor-pointer touch:bg-white/15"
      >
        {recommendations}
      </li>

      <li
        class="py-1 px-3 rounded-full hover:bg-slate-300 transition-all duration-300 ease-in-out cursor-pointer"
      >
        {moving}
      </li>

      <!-- <li
        class="py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        Otra cosa
      </li> -->
    </ul>
  </div>
  <!-- Menu lateral -->
  <div class="shrink-0 mr-8 ml-5 lg:ml-0 sm:ml-0">
    <ul class="flex space-between text-base shrink-0">
      <li
        class="hidden xs:flex py-1 px-3 rounded-full hover:bg-slate-300 transition-all duration-300 ease-in-out cursor-pointer"
      >
        <a href=`/${lang}/instructions`>
          {instructions}
        </a>
      </li>
      <li
        class="hidden xs:flex py-1 px-3 rounded-full hover:bg-slate-300 transition-all duration-300 ease-in-out cursor-pointer"
      >
        {rules}
      </li>
      <div class="rounded-full touch:p-0.5  touch:border touch:border-white/50">
        <li
          class="py-1 px-3 rounded-full hover:bg-slate-300 transition-all duration-300 ease-in-out cursor-pointer
           touch:bg-slate-300/65 touch:outline-offset-3 touch:outline-white/90"
        >
          Menu
        </li>
      </div>
    </ul>
  </div>
</div>
