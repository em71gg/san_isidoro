---
const { instructions, rules, recommendations, moving, lang } = Astro.props;
---

<!--Header--><!--Div delimitador header -->
<div
  class="flex justify-between font-bold items-end transition-all duration-300 ease-in-out hover:bg-slate-200 py-4 text-slate-900"
>
  <!-- Div logo -->
  <div class="hidden sm:inline ml-8">
    <p class="hidden sm:inline w-28">SAN ISIDORO 12 APTO. 14</p>
  </div>
  <!-- Div menu central -->
  <div class="hidden lg:inline">
    <ul class="flex space-between text-sm">
      <li
        class="py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        {recommendations}
      </li>
      <li
        class="py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        {moving}
      </li>

      <!-- <li
        class="py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        Otra cosa
      </li> -->
    </ul>
  </div>
  <!-- Menu lateral -->
  <div class="shrink-0 mr-8 ml-5 sm:ml-0">
    <ul class="flex space-between text-sm shrink-0">
      <li
        class="hidden mobile:flex py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        <a href=`/${lang}/instructions`>
          {instructions}
        </a>
      </li>
      <li
        class="hidden mobile:flex py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        {rules}
      </li>
      <li
        class="py-1 px-3 rounded-full transition-all duration-300 ease-in-out hover:bg-slate-300 cursor-pointer"
      >
        Menu
      </li>
    </ul>
  </div>
</div>
